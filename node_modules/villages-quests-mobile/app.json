
{
  "expo": {
    "name": "Villages Quests",
    "slug": "villages-quests-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22c55e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22c55e"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "villagesquests",
    "sdkVersion": "54.0.0",
    "packagerOpts": {
      "config": "metro.config.js"
    }
  }
}